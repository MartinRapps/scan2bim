# Scan-to-BIM Pipeline — example environment configuration.
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# The shell scripts source `.env` via pipeline_lib.sh::load_env and the values
# are also forwarded to the Docker containers where relevant.

# --- HuggingFace (gated SAM 3.1 model access) ---
# Create a token at https://huggingface.co/settings/tokens (starts with hf_).
# The pipeline validates it before starting SAM3 and never writes its value to
# run.log or run.md.
HF_TOKEN=

# --- Host user mapping (container runs as this UID/GID so output files are
#     owned by you on the host; the master scripts derive the current values
#     by default. Set them explicitly only for a different identity.) ---
# HOST_UID=1000
# HOST_GID=1000

# --- Orchestration ---
# Run non-interactively with documented defaults after the prompt entry.
AUTOPILOT=false

# --- SAM 3 frame extraction ---
SAM3_FRAME_MAX_SIDE=768
SAM3_MAX_FRAMES_PER_CHUNK=8

# --- Shared frame profile ---
# `all` (default): the generated 1280x720 / 5 FPS profile is used by SAM3,
# COLMAP and the downstream STS/SuGaR dataset. `colmap` is a benchmark-only
# profile: the pipeline stops after COLMAP because a separate frame set needs
# a separately matching SAM3 mask set before STS can consume it.
FRAME_PROFILE_SCOPE=all

# COLMAP defaults: OPENCV is the production standard chosen from the matrix
# evaluation (best masked object metrics at 720p / 5 FPS, Route A). SIMPLE_RADIAL
# remains available for comparisons.
COLMAP_CAMERA_MODEL=OPENCV
COLMAP_MAX_FEATURES=4096
COLMAP_SEQUENTIAL_OVERLAP=15
COLMAP_GUIDED_MATCHING=0
COLMAP_SIFT_PEAK_THRESHOLD=0.003

# The FHD SAM3/STS experiment is intentionally separate from the current
# COLMAP profile. Set 1920x1080 and the desired FPS interactively for that run;
# do not mix its masks with a 720p/5 FPS COLMAP frame set.

# --- STS training ---
# STS total: 5000 object-mask curriculum iterations + 2000 all-object iterations.
ITERATIONS=7000
STAGE2_ITERS=5000

# --- SuGaR object filtering / geometry input ---
FILTER_MIN_OPACITY=0.01
FILTER_BLACK_THRESHOLD=0.08
SUGAR_INPUT_ALPHA=0.999999

# --- SuGaR meshing ---
REGULARIZATION=dn_consistency
REFINEMENT_TIME=medium
MESH_VERTICES=200000
SURFACE_SAMPLE_COUNT=5000000
COARSE_ITERATIONS=9000
# Screening mode: stop after coarse mesh, skip refinement/UV/crop.
STOP_AFTER_COARSE_MESH=0
RUN_CONSENSUS_CROP=0

# --- Mask-aware SuGaR supervision ---
MASK_LEVEL=default
MASK_DILATION_PX=0
NORMAL_MASK_LEVEL=middle
TEXTURE_MASK_LEVEL=default
TEXTURE_MASK_DILATION_PX=0

# --- Centerline extraction (Container E) ---
CENTERLINE_MODE=single
VOXEL_SIZE=0.1
MIN_PATH_LENGTH=0.75
# B-Spline
BSPLINE_DEGREE=10
BSPLINE_SAMPLES_PER_SEGMENT=4
SEGMENT_CORNERS=0
SEGMENT_CORNER_WINDOW=4
SEGMENT_CORNER_ANGLE=30

# --- Georeferencing fallback (UTM anchor used when matrix.txt/anchor.txt are
#     missing; example: 32U zone) ---
FALLBACK_ANCHOR=567028.563,5516784.082,177
GEOJSON_SRS=EPSG:25832

# --- SuGaR run identity (auto-generated if unset) ---
# SUGAR_RUN_TAG=
# SUGAR_MESH_EXPORT_NAME=
